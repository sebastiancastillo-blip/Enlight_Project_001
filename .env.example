# Copiar este archivo como .env y llenar los datos reales del proveedor/API.
PORT=3000

# URL base de la API del proveedor. Ejemplo:
# PROVIDER_API_BASE_URL=https://api.proveedor.com/v1
PROVIDER_API_BASE_URL=https://api.proveedor.com/v1

# API key real. No debe colocarse en index.html ni script.js.
PROVIDER_API_KEY=PEGAR_API_KEY_REAL_AQUI

# Identificador de la planta FAURECIA 0425.
PLANT_NE=36297896

# Modo mock para pruebas sin API real: true o false.
MOCK_MODE=true
